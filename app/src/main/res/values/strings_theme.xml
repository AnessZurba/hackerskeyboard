<!-- Theme settings (kr.jcb1ee.hackerskeyboard2.theme). -->
<resources>
    <!-- Description for keyboard theme switcher -->
    <string name="keyboard_layout">Keyboard Theme</string>
    <string name="title_key_borders">Key borders</string>
    <string name="summary_key_borders_on">Keys are drawn as shapes</string>
    <string name="summary_key_borders_off">Labels only; a key lights up while pressed (flat themes)</string>

    <string name="theme_family_material" translatable="false">Material</string>
    <string name="theme_family_material_you" translatable="false">Material You (wallpaper colours)</string>
    <string name="theme_family_high_contrast" translatable="false">High contrast</string>
    <string name="theme_family_typewriter" translatable="false">Typewriter</string>
    <string name="theme_family_keycaps" translatable="false">Keycaps</string>
    <string name="theme_family_terminal" translatable="false">Retro terminal</string>
    <string name="theme_family_custom">Custom</string>

    <!--
    The stored value is a theme family id (kr.jcb1ee.hackerskeyboard2.theme.ThemeFamily).
    Do *NOT* renumber existing entries, this would lead to people's stored preferences
    being reinterpreted as different themes. Ids of removed themes (0-4, 6, 9) and of
    variants (5, 11, 14, 16) must not be reused either. A new theme takes the next free
    number (18 and up).
    -->
    <string-array name="keyboard_layout_modes" translatable="false">
        <item>@string/theme_family_material_you</item>
        <item>@string/theme_family_material</item>
        <item>@string/theme_family_high_contrast</item>
        <item>@string/theme_family_typewriter</item>
        <item>@string/theme_family_keycaps</item>
        <item>@string/theme_family_terminal</item>
        <item>@string/theme_family_custom</item>
    </string-array>
    <string-array name="keyboard_layout_modes_values" translatable="false">
        <item>8</item>
        <item>7</item>
        <item>10</item>
        <item>12</item>
        <item>13</item>
        <item>15</item>
        <item>17</item>
    </string-array>

    <!-- The custom theme's base: every theme but Custom. -->
    <string-array name="custom_theme_base_names" translatable="false">
        <item>@string/theme_family_material_you</item>
        <item>@string/theme_family_material</item>
        <item>@string/theme_family_high_contrast</item>
        <item>@string/theme_family_typewriter</item>
