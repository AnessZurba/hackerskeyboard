<?xml version="1.0" encoding="utf-8"?>
<!-- The key press preview bubble before a theme is applied (the theme draws its own, see
     KeyboardLook#previewBubble). The padding keeps the label clear of the edges. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF263238" />
    <stroke android:width="1dp" android:color="#FF4F5B62" />
    <corners android:radius="10dp" />
    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="10dp" />
</shape>
